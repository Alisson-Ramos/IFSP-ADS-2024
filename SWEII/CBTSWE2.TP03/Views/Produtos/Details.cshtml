@model Produto
@{
    ViewData["Title"] = Model.Nome;
    var corSituacao = Model.QuantidadeEstoque == 0 ? "bg-danger" : Model.QuantidadeEstoque <= 10 ? "bg-warning text-dark" : "bg-success";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">Produtos</a></li>
        <li class="breadcrumb-item active" aria-current="page">Detalhes</li>
    </ol>
</nav>

<div class="card card-formulario shadow-sm">
    <div class="card-header bg-white d-flex justify-content-between align-items-center">
        <h1 class="h4 titulo-pagina mb-0">@Model.Nome</h1>
        <span class="badge @corSituacao">@Model.SituacaoEstoque</span>
    </div>
    <div class="card-body">
        <dl class="row detalhes mb-0">
            <dt class="col-sm-4">Código</dt>
            <dd class="col-sm-8">#@Model.Id.ToString("D4")</dd>

            <dt class="col-sm-4">@Html.DisplayNameFor(m => m.Descricao)</dt>
            <dd class="col-sm-8" style="white-space: pre-line">@Model.Descricao</dd>

            <dt class="col-sm-4">@Html.DisplayNameFor(m => m.Preco)</dt>
            <dd class="col-sm-8 fw-semibold">@Model.Preco.ToString("C")</dd>

            <dt class="col-sm-4">@Html.DisplayNameFor(m => m.QuantidadeEstoque)</dt>
            <dd class="col-sm-8">@Model.QuantidadeEstoque.ToString("N0") unidade(s)</dd>

            <dt class="col-sm-4">@Html.DisplayNameFor(m => m.ValorEmEstoque)</dt>
            <dd class="col-sm-8">@Model.ValorEmEstoque.ToString("C")</dd>

            <dt class="col-sm-4">@Html.DisplayNameFor(m => m.DataCadastro)</dt>
            <dd class="col-sm-8">@Model.DataCadastro.ToString("dd/MM/yyyy HH:mm")</dd>
        </dl>
    </div>
    <div class="card-footer bg-white d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">
            <i class="bi bi-pencil"></i> Editar
        </a>
        <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger">
            <i class="bi bi-trash"></i> Excluir
        </a>
        <a asp-action="Index" class="btn btn-outline-secondary ms-auto">
            <i class="bi bi-arrow-left"></i> Voltar
        </a>
    </div>
</div>
