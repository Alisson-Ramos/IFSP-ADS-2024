@{
    var codigo = ViewData["Codigo"] as int? ?? 0;
    ViewData["Title"] = codigo == 404 ? "Página não encontrada" : "Erro";
}

<div class="text-center py-5">
    <div class="display-1 fw-bold text-secondary">@codigo</div>
    @if (codigo == 404)
    {
        <h1 class="h4">Página ou produto não encontrado.</h1>
        <p class="text-muted">O endereço pode estar errado ou o produto pode ter sido excluído.</p>
    }
    else
    {
        <h1 class="h4">Não foi possível atender à solicitação.</h1>
    }
    <a asp-controller="Produtos" asp-action="Index" class="btn btn-primary mt-2">
        <i class="bi bi-arrow-left"></i> Voltar para a lista de produtos
    </a>
</div>
