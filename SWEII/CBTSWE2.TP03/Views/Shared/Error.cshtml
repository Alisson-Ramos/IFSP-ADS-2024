@model ErrorViewModel
@{
    ViewData["Title"] = "Erro";
}

<div class="text-center py-5">
    <i class="bi bi-exclamation-triangle text-danger" style="font-size: 3rem;"></i>
    <h1 class="h3 mt-3 text-danger">Ocorreu um erro ao processar sua solicitação.</h1>
    <p class="text-muted">Tente novamente em instantes.</p>

    @if (Model.ShowRequestId)
    {
        <p class="small text-muted">Código da requisição: <code>@Model.RequestId</code></p>
    }

    <a asp-controller="Produtos" asp-action="Index" class="btn btn-primary mt-2">
        <i class="bi bi-arrow-left"></i> Voltar para a lista de produtos
    </a>
</div>
